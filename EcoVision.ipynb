# 8. DATASET EXTRACTION
# ================================================================

def extract_dataset(zip_file):

    global dataset_statistics

    if zip_file is None:

        return (
            "❌ Please upload a ZIP dataset first.",
            None,
            None
        ) 

    try:

        print("\n📦 Extracting dataset...")

        clear_directory(
            DATASET_DIR
        )

        zip_path = zip_file

        with zipfile.ZipFile(
            zip_path,
            "r"
        ) as zip_ref:

            zip_ref.extractall(
                DATASET_DIR
            )

        print("✅ ZIP extracted.")

        # --------------------------------------------------------
        # Find folder containing class folders
        # --------------------------------------------------------

        dataset_root = None

        for root, dirs, files in os.walk(
            DATASET_DIR
        ):

            valid_class_dirs = []

            for directory in dirs:

                class_path = os.path.join(
                    root,
                    directory
                )

                image_files = [
                    f
                    for f in os.listdir(
                        class_path
                    )
                    if is_valid_image(f)
                ]

                if len(image_files) > 0:

                    valid_class_dirs.append(
                        directory
                    )

            if len(valid_class_dirs) >= 2:

                dataset_root = root

                break

        if dataset_root is None:

            return (
                "❌ Could not detect class folders.\n\n"
                "Make sure your ZIP contains folders such as "
                "`plastic`, `paper`, `glass`, etc.",
                None,
                None
            )

        # --------------------------------------------------------
        # Detect classes
        # --------------------------------------------------------

        classes = sorted(
            [
                directory
                for directory in os.listdir(
                    dataset_root
                )
                if os.path.isdir(
                    os.path.join(
                        dataset_root,
                        directory
                    )
                )
            ]
        )

        if len(classes) < 2:

            return (
                "❌ At least two classes are required.",
                None,
                None
            )

        # --------------------------------------------------------
        # Generate statistics
        # --------------------------------------------------------

        records = []

        total_images = 0

        for class_name in classes:

            class_path = os.path.join(
                dataset_root,
                class_name
            )

            images = [
                f
                for f in os.listdir(
                    class_path
                )
                if is_valid_image(f)
            ]

            count = len(images)

            total_images += count

            records.append(
                {
                    "Waste Category":
                        class_name,

                    "Images":
                        count
                }
            )

        dataset_statistics = pd.DataFrame(
            records
        )

        # --------------------------------------------------------
        # Save root
        # --------------------------------------------------------

        with open(
            DATASET_ROOT_FILE,
            "w"
        ) as f:

            f.write(
                dataset_root
            )

        # --------------------------------------------------------
        # Create chart
        # --------------------------------------------------------

        plt.figure(
            figsize=(10, 5)
        )

        plt.bar(
            dataset_statistics[
                "Waste Category"
            ],
            dataset_statistics[
                "Images"
            ]
        )

        plt.title(
            "EcoVision Dataset Distribution",
            fontsize=17,
            fontweight="bold"
        )

        plt.xlabel(
            "Waste Category"
        )

        plt.ylabel(
            "Number of Images"
        )

        plt.xticks(
            rotation=30
        )

        plt.tight_layout()

        dataset_chart_path = os.path.join(
            OUTPUT_DIR,
            "dataset_distribution.png"
        )

        plt.savefig(
            dataset_chart_path,
            dpi=150
        )

        plt.close()

        # --------------------------------------------------------
        # Result
        # --------------------------------------------------------

        class_text = "\n".join(
            [
                f"• **{row['Waste Category']}** — "
                f"{row['Images']} images"
                for _, row
                in dataset_statistics.iterrows()
            ]
        )

        result = f"""
# ✅ Dataset Loaded Successfully

### Dataset Summary

**Total Images:** `{total_images}`

**Number of Classes:** `{len(classes)}`

**Dataset Root:**

`{dataset_root}`

### Detected Waste Categories

{class_text}

The dataset is ready for model preparation.
"""

        return (
            result,
            dataset_statistics,
            dataset_chart_path
        )

    except Exception as e:

        return (
            f"❌ Dataset extraction failed:\n\n`{str(e)}`",
            None,
            None
        )


