# ================================================================
# 15. IMAGE PREDICTION
# ================================================================

def predict_waste(
    image
):

    global prediction_history
    global model

    if image is None:

        return (
            "❌ Please upload an image.",
            None,
            None
        )

    # ------------------------------------------------------------
    # Automatically load model
    # ------------------------------------------------------------

    if model is None:

        if os.path.exists(
            MODEL_PATH
        ):

            load_existing_model()

        else:

            return (
                "❌ Train the model or load an existing model first.",
                None,
                None
            )

    try:

        # --------------------------------------------------------
        # Convert image
        # --------------------------------------------------------

        if isinstance(
            image,
            np.ndarray
        ):

            image_pil = Image.fromarray(
                image.astype(
                    "uint8"
                )
            )

        else:

            image_pil = image

        image_pil = image_pil.convert(
            "RGB"
        )

        # --------------------------------------------------------
        # Resize
        # --------------------------------------------------------

        resized = image_pil.resize(
            IMG_SIZE
        )

        image_array = np.array(
            resized,
            dtype=np.float32
        )

        image_array = np.expand_dims(
            image_array,
            axis=0
        )

        # --------------------------------------------------------
        # Prediction
        # --------------------------------------------------------

        predictions = model.predict(
            image_array,
            verbose=0
        )[0]

        # --------------------------------------------------------
        # Top 5
        # --------------------------------------------------------

        top_indices = np.argsort(
            predictions
        )[::-1][:5]

        results = []

        for index in top_indices:

            results.append(
                {
                    "Waste Category":
                        class_names[index],

                    "Confidence":
                        round(
                            float(
                                predictions[index]
                            ) * 100,
                            2
                        )
                }
            )

        results_df = pd.DataFrame(
            results
        )

        # --------------------------------------------------------
        # Main prediction
        # --------------------------------------------------------

        best_index = int(
            np.argmax(
                predictions
            )
        )

        predicted_class = (
            class_names[
                best_index
            ]
        )

        confidence = (
            float(
                predictions[
                    best_index
                ]
            ) * 100
        )

        # --------------------------------------------------------
        # Confidence level
        # --------------------------------------------------------

        if confidence >= 85:

            confidence_level = (
                "🟢 VERY HIGH"
            )

        elif confidence >= 65:

            confidence_level = (
                "🟡 MODERATE"
            )

        else:

            confidence_level = (
                "🔴 LOW"
            )

        # --------------------------------------------------------
        # Recycling recommendation
        # --------------------------------------------------------

        normalized_class = (
            predicted_class
            .lower()
            .strip()
        )

        recommendation = (
            RECYCLING_GUIDE.get(
                normalized_class,
                "♻️ Check your local recycling guidelines for this category."
            )
        )

        # --------------------------------------------------------
        # Result markdown
        # --------------------------------------------------------

        result_text = f"""
# ♻️ EcoVision Result

## **{predicted_class.upper()}**

### 🎯 Confidence

# `{confidence:.2f}%`

### Confidence Level

{confidence_level}

---

## ♻️ Recycling Recommendation

{recommendation}

---

## 🔍 Top Predictions

{results_df.to_string(index=False)}
"""

        # --------------------------------------------------------
        # Save history
        # --------------------------------------------------------

        prediction_history.append(
            {
                "Time":
                    datetime.now().strftime(
                        "%Y-%m-%d %H:%M:%S"
                    ),

                "Prediction":
                    predicted_class,

                "Confidence":
                    round(
                        confidence,
                        2
                    )
            }
        )

        # --------------------------------------------------------
        # Probability chart
        # --------------------------------------------------------

        chart_df = results_df.copy()

        plt.figure(
            figsize=(10, 5)
        )

        plt.barh(
            chart_df[
                "Waste Category"
            ][::-1],

            chart_df[
                "Confidence"
            ][::-1]
        )

        plt.xlabel(
            "Confidence (%)"
        )

        plt.ylabel(
            "Waste Category"
        )

        plt.title(
            "EcoVision Prediction Probabilities",
            fontsize=17,
            fontweight="bold"
        )

        plt.xlim(
            0,
            100
        )

        plt.tight_layout()

        probability_path = os.path.join(
            OUTPUT_DIR,
            "prediction_probabilities.png"
        )

        plt.savefig(
            probability_path,
            dpi=150
        )

        plt.close()

        return (
            result_text,
            probability_path,
            results_df
        )

    except Exception as e:

        return (
            f"❌ Prediction failed:\n\n`{str(e)}`",
            None,
            None
        )


