# 16. PREDICTION HISTORY
# ================================================================

def get_prediction_history():

    if len(
        prediction_history
    ) == 0:

        return pd.DataFrame(
            columns=[
                "Time",
                "Prediction",
                "Confidence"
            ]
        )

    return pd.DataFrame(
        prediction_history
    )


def clear_prediction_history():

    global prediction_history

    prediction_history = []

    return get_prediction_history()


# ================================================================
# 17. CLASSIFICATION REPORT
# ================================================================

def generate_classification_report():

    if model is None:

        return (
            "❌ Train or load a model first."
        )

    if validation_dataset is None:

        return (
            "❌ Validation dataset is not available."
        )

    try:

        y_true = []
        y_pred = []

        for images, labels in validation_dataset:

            predictions = model.predict(
                images,
                verbose=0
            )

            y_true.extend(
                np.argmax(
                    labels.numpy(),
                    axis=1
                )
            )

            y_pred.extend(
                np.argmax(
                    predictions,
                    axis=1
                )
            )

        report = classification_report(
            y_true,
            y_pred,
            target_names=class_names,
            digits=4
        )

        return f"""
# 📊 Classification Report

```text
{report}
```
"""
    except Exception as e:
        return f"❌ Failed to generate report: {str(e)}"


# ================================================================
# 18. CONFUSION MATRIX
# ================================================================

def generate_confusion_matrix():

    if model is None:
        return "❌ Train or load a model first.", None

    if validation_dataset is None:
        return "❌ Validation dataset is not available.", None

    try:
        y_true = []
        y_pred = []

        for images, labels in validation_dataset:
            predictions = model.predict(images, verbose=0)
            y_true.extend(np.argmax(labels.numpy(), axis=1))
            y_pred.extend(np.argmax(predictions, axis=1))

        cm = confusion_matrix(y_true, y_pred)
        
        plt.figure(figsize=(8, 6))
        sns.heatmap(
            cm, 
            annot=True, 
            fmt="d", 
            cmap="Blues", 
            xticklabels=class_names, 
            yticklabels=class_names
        )
        plt.title("EcoVision Confusion Matrix", fontsize=15, fontweight="bold")
        plt.ylabel("True Class")
        plt.xlabel("Predicted Class")
        plt.tight_layout()

        cm_path = os.path.join(OUTPUT_DIR, "confusion_matrix.png")
        plt.savefig(cm_path, dpi=150)
        plt.close()

        return "# ✅ Confusion Matrix Generated Successfully", cm_path
    except Exception as e:
        return f"❌ Failed to generate matrix: {str(e)}", None


# ================================================================
# 19. GRADIO UI SYSTEM
# ================================================================

def build_ui():
    with gr.Blocks(theme=gr.themes.Soft()) as demo:
        gr.Markdown("# 🌱 EcoVision AI - Waste Classification System")
        gr.Markdown(f"{DEVICE_STATUS}")
        
        with gr.Tab("📦 Dataset Setup"):
            zip_input = gr.File(label="Upload waste_dataset.zip")
            btn_extract = gr.Button("Extract & Parse Dataset", variant="primary")
            stats_out = gr.Markdown()
            df_out = gr.DataFrame()
            img_out = gr.Image()
            
            btn_extract.click(
                extract_dataset, 
                inputs=[zip_input], 
                outputs=[stats_out, df_out, img_out]
            )
            
        with gr.Tab("⚙️ Preparation & Training"):
            btn_prep = gr.Button("Prepare TF Datasets")
            prep_out = gr.Markdown()
            
            epochs_input = gr.Number(value=DEFAULT_EPOCHS, label="Epochs (1-50)", precision=0)
            btn_train = gr.Button("Train MobileNetV2 Base", variant="primary")
            train_out = gr.Markdown()
            acc_img = gr.Image()
            loss_img = gr.Image()
            
            btn_prep.click(prepare_datasets, outputs=[prep_out])
            btn_train.click(
                train_ecovision, 
                inputs=[epochs_input], 
                outputs=[train_out, acc_img, loss_img]
            )
            
        with gr.Tab("🔮 Waste Classifier"):
            with gr.Row():
                img_input = gr.Image(type="pil", label="Take or Upload Waste Image")
                with gr.Column():
                    pred_out = gr.Markdown()
                    prob_img = gr.Image()
                    predictions_df = gr.DataFrame()
            
            btn_predict = gr.Button("Predict Waste Category", variant="primary")
            btn_predict.click(
                predict_waste, 
                inputs=[img_input], 
                outputs=[pred_out, prob_img, predictions_df]
            )
            
        with gr.Tab("📊 Diagnostics & History"):
            btn_history = gr.Button("Refresh Prediction History")
            history_df = gr.DataFrame()
            btn_clear_history = gr.Button("Clear History")
            
            btn_report = gr.Button("Generate Classification Report")
            report_out = gr.Markdown()
            
            btn_cm = gr.Button("Generate Confusion Matrix")
            cm_out = gr.Markdown()
            cm_img = gr.Image()
            
            btn_history.click(get_prediction_history, outputs=[history_df])
            btn_clear_history.click(clear_prediction_history, outputs=[history_df])
            btn_report.click(generate_classification_report, outputs=[report_out])
            btn_cm.click(generate_confusion_matrix, outputs=[cm_out, cm_img])
            
    return demo

if __name__ == "__main__":
    # Run Gradio application interface
    demo = build_ui()
    demo.launch(inline=True, share=False)
