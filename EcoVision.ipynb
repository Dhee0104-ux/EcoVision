def prepare_datasets():

    global train_dataset
    global validation_dataset
    global class_names

    if not os.path.exists(
        DATASET_ROOT_FILE
    ):

        return (
            "❌ Load your dataset first."
        )

    try:

        with open(
            DATASET_ROOT_FILE,
            "r"
        ) as f:

            dataset_root = f.read().strip()

        print(
            "\n📂 Dataset:",
            dataset_root
        )

        # --------------------------------------------------------
        # Training dataset
        # --------------------------------------------------------

        train_dataset = (
            tf.keras.utils
            .image_dataset_from_directory(
                dataset_root,

                validation_split=0.2,

                subset="training",

                seed=RANDOM_SEED,

                image_size=IMG_SIZE,

                batch_size=BATCH_SIZE,

                label_mode="categorical"
            )
        )

        # --------------------------------------------------------
        # Validation dataset
        # --------------------------------------------------------

        validation_dataset = (
            tf.keras.utils
            .image_dataset_from_directory(
                dataset_root,

                validation_split=0.2,

                subset="validation",

                seed=RANDOM_SEED,

                image_size=IMG_SIZE,

                batch_size=BATCH_SIZE,

                label_mode="categorical"
            )
        )

        class_names = (
            train_dataset.class_names
        )

        # --------------------------------------------------------
        # Save class names
        # --------------------------------------------------------

        with open(
            CLASS_PATH,
            "w"
        ) as f:

            json.dump(
                class_names,
                f
            )

        # --------------------------------------------------------
        # Optimize pipeline
        # --------------------------------------------------------

        AUTOTUNE = (
            tf.data.AUTOTUNE
        )

        train_dataset = (
            train_dataset
            .prefetch(AUTOTUNE)
        )

        validation_dataset = (
            validation_dataset
            .prefetch(AUTOTUNE)
        )

        return f"""
# ✅ Dataset Prepared

### Classes

{chr(10).join([f"• {x}" for x in class_names])}

### Training Split

80%

### Validation Split

20%

### Image Size

`224 × 224`

### Batch Size

`{BATCH_SIZE}`

Ready to train the EcoVision model.
"""

    except Exception as e:

        return (
            f"❌ Dataset preparation failed:\n\n`{str(e)}`"
        )


# ================================================================
# 10. DATA AUGMENTATION
# ================================================================

data_augmentation = keras.Sequential(
    [

        layers.RandomFlip(
            "horizontal"
        ),

        layers.RandomRotation(
            0.08
        ),

        layers.RandomZoom(
            0.15
        ),

        layers.RandomContrast(
            0.10
        )

    ],

    name="EcoVision_Data_Augmentation"
)

# ================================================================
# 11. BUILD MOBILENETV2 MODEL
# ================================================================

def build_ecovision_model(
    number_of_classes
):

    print(
        "\n🧠 Loading MobileNetV2..."
    )

    base_model = MobileNetV2(
        input_shape=IMG_SIZE + (3,),

        include_top=False,

        weights="imagenet"
    )

    # Freeze pretrained layers
    base_model.trainable = False

    inputs = keras.Input(
        shape=IMG_SIZE + (3,)
    )

    # Data augmentation
    x = data_augmentation(
        inputs
    )

    # MobileNetV2 preprocessing
    x = preprocess_input(
        x
    )

    # Feature extraction
    x = base_model(
        x,
        training=False
    )

    # Global pooling
    x = layers.GlobalAveragePooling2D()(
        x
    )

    # Dropout
    x = layers.Dropout(
        0.35
    )(x)

    # Dense layer
    x = layers.Dense(
        128,
        activation="relu"
    )(x)

    # More dropout
    x = layers.Dropout(
        0.25
    )(x)

    # Classification
    outputs = layers.Dense(
        number_of_classes,
        activation="softmax"
    )(x)

    model = keras.Model(
        inputs,
        outputs,
        name="EcoVision_MobileNetV2"
    )

    model.compile(

        optimizer=keras.optimizers.Adam(
            learning_rate=0.0001
        ),

        loss="categorical_crossentropy",

        metrics=[
            "accuracy"
        ]
    )

    return model


# ================================================================
# 12. TRAIN MODEL
# ================================================================

def train_ecovision(
    epochs
):

    global model
    global training_history

    if train_dataset is None:

        return (
            "❌ Prepare the dataset first.",
            None,
            None
        )

    try:

        epochs = int(
            epochs
        )

        epochs = max(
            1,
            min(
                epochs,
                50
            )
        )

        print(
            f"\n🚀 Training for {epochs} epochs..."
        )

        # --------------------------------------------------------
        # Build model
        # --------------------------------------------------------

        model = build_ecovision_model(
            len(class_names)
        )

        # --------------------------------------------------------
        # Callbacks
        # --------------------------------------------------------

        callbacks = [

            keras.callbacks.EarlyStopping(

                monitor="val_loss",

                patience=3,

                restore_best_weights=True
            ),

            keras.callbacks.ReduceLROnPlateau(

                monitor="val_loss",

                factor=0.3,

                patience=2,

                min_lr=1e-7
            ),

            keras.callbacks.ModelCheckpoint(

                MODEL_PATH,

                monitor="val_accuracy",

                save_best_only=True
            )
        ]

        # --------------------------------------------------------
        # Train
        # --------------------------------------------------------

        history = model.fit(

            train_dataset,

            validation_data=validation_dataset,

            epochs=epochs,

            callbacks=callbacks,

            verbose=1
        )

        training_history = (
            history.history
        )

        # --------------------------------------------------------
        # Save history
        # --------------------------------------------------------

        with open(
            HISTORY_PATH,
            "w"
        ) as f:

            json.dump(
                training_history,
                f
            )

        # --------------------------------------------------------
        # Load best model
        # --------------------------------------------------------

        if os.path.exists(
            MODEL_PATH
        ):

            model = keras.models.load_model(
                MODEL_PATH
            )

        # --------------------------------------------------------
        # Evaluate
        # --------------------------------------------------------

        evaluation = model.evaluate(
            validation_dataset,
            verbose=0
        )

        validation_loss = (
            evaluation[0]
        )

        validation_accuracy = (
            evaluation[1]
        )

        # ========================================================
        # ACCURACY GRAPH
        # ========================================================

        plt.figure(
            figsize=(10, 5)
        )

        plt.plot(
            training_history[
                "accuracy"
            ],
            label="Training Accuracy"
        )

        plt.plot(
            training_history[
                "val_accuracy"
            ],
            label="Validation Accuracy"
        )

        plt.title(
            "EcoVision Training Accuracy",
            fontsize=17,
            fontweight="bold"
        )

        plt.xlabel(
            "Epoch"
        )

        plt.ylabel(
            "Accuracy"
        )

        plt.legend()

        plt.grid(
            alpha=0.2
        )

        plt.tight_layout()

        accuracy_path = os.path.join(
            OUTPUT_DIR,
            "accuracy.png"
        )

        plt.savefig(
            accuracy_path,
            dpi=150
        )

        plt.close()

        # ========================================================
        # LOSS GRAPH
        # ========================================================

        plt.figure(
            figsize=(10, 5)
        )

        plt.plot(
            training_history[
                "loss"
            ],
            label="Training Loss"
        )

        plt.plot(
            training_history[
                "val_loss"
            ],
            label="Validation Loss"
        )

        plt.title(
            "EcoVision Training Loss",
            fontsize=17,
            fontweight="bold"
        )

        plt.xlabel(
            "Epoch"
        )

        plt.ylabel(
            "Loss"
        )

        plt.legend()

        plt.grid(
            alpha=0.2
        )

        plt.tight_layout()

        loss_path = os.path.join(
            OUTPUT_DIR,
            "loss.png"
        )

        plt.savefig(
            loss_path,
            dpi=150
        )

        plt.close()

        # ========================================================
        # TRAINING RESULT
        # ========================================================

        result = f"""
# 🎉 EcoVision Training Complete

## 🧠 Model

**MobileNetV2 Transfer Learning**

## ♻️ Waste Categories

{ ", ".join(class_names) }

## 📊 Training

**Epochs Completed:** `{len(training_history["accuracy"])}`

**Validation Accuracy:** `{validation_accuracy * 100:.2f}%`

**Validation Loss:** `{validation_loss:.4f}`

## 💾 Model

`{MODEL_PATH}`

The model is ready for image classification.
"""

        return (
            result,
            accuracy_path,
            loss_path
        )

    except Exception as e:

        return (
            f"❌ Training failed:\n\n`{str(e)}`",
            None,
            None
        )


