def clear_directory(directory):

    if not os.path.exists(directory):

        return

    for item in os.listdir(directory):

        path = os.path.join(
            directory,
            item
        )

        if os.path.isdir(path):

            shutil.rmtree(path)

        else:

            os.remove(path)


def is_valid_image(filename):

    extensions = (
        ".jpg",
        ".jpeg",
        ".png",
        ".bmp",
        ".webp"
    )

    return filename.lower().endswith(
        extensions
    )


